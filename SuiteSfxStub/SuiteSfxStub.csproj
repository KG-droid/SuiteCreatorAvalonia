<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0-windows10.0.22000.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<PublishAot>true</PublishAot>
		<InvariantGlobalization>true</InvariantGlobalization>
		<ApplicationIcon>SuiteCreatorLogo.ico</ApplicationIcon>
		<PackageIcon>SuiteCreatorLogoImage.png</PackageIcon>
		<Platforms>AnyCPU;x64</Platforms>
		<SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <Version>1.0.1</Version>
        <AssemblyVersion>1.0.1</AssemblyVersion>
        <FileVersion>1.0.1</FileVersion>
	</PropertyGroup>

	<ItemGroup>
		<Content Include="SuiteCreatorLogo.ico" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\SuiteCreatorAvalonia\Assets\Images\SuiteCreatorLogoImage.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\SystemTools\SystemTools.csproj" />
	</ItemGroup>

</Project>
