
<UserControl 
	xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:fc="using:FluentAvalonia.UI.Controls"
	xmlns:mi="using:Material.Icons.Avalonia"
	xmlns:vm="clr-namespace:SuiteCreatorAvalonia.ViewModels.RuleBuilder"
	xmlns:services="using:SuiteCreatorAvalonia.Services"
	mc:Ignorable="d"
	DragDrop.AllowDrop="True"
	DragDrop.DragOver="RuleDragOver"
	DragDrop.Drop="Card_Drop"
	x:CompileBindings="True"
	HorizontalAlignment="{Binding CardHorizontalAlignment}"
	services:DialogManager.Register="{Binding}"
	x:DataType="vm:RuleCardViewModel"
	x:Class="SuiteCreatorAvalonia.Views.RuleBuilder.RuleCardView">

	<Design.DataContext>
		<vm:RuleCardViewModel/>
	</Design.DataContext>

	<Grid
		ColumnDefinitions="*,Auto">
		<Grid
			Margin="2">
			<Border
				x:Name="CardMainBorder"
				CornerRadius="5"
				Classes="RuleCard">
				<Border.Styles>
					<Style Selector="Border.RuleCard">
						<Setter Property="Background" Value="{DynamicResource AccentVariant1}"/>
					</Style>
					<Style Selector="Border.RuleCard:pointerover">
						<Setter Property="Background" Value="{DynamicResource AccentVariant2}"/>
					</Style>
				</Border.Styles>
				<Grid
					ColumnDefinitions="Auto,*">
					<mi:MaterialIcon
						PointerPressed="RulePointerPressed"
						Margin="0,5,0,5"
						Kind="DragVertical"
						ToolTip.Tip="Click and hold to drag to a another position"
						Grid.Column="0"
						Width="30"
						Height="30"
						Background="Transparent"/>
					<UserControl
						HorizontalAlignment="Stretch"
						VerticalAlignment="Center"
						Content="{Binding CardInnerView}"
						Margin="5"
						Grid.Column="1"/>
				</Grid>
			</Border>
		</Grid>
		<Button
			IsVisible="{Binding IsBinButtonVisible}"
			Height="30"
			Width="30"
			Grid.Column="2"
			Classes="BinButton"
			Click="RemoveCard"
			VerticalAlignment="Center"
			ToolTip.Tip="Delete this card"
			Margin="0,0,0,0"/>
	</Grid>
	
</UserControl>
