<UserControl 
	xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:vm="clr-namespace:SuiteCreatorAvalonia.ViewModels"  
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
    x:Class="SuiteCreatorAvalonia.Views.EventBuilderView"
    x:DataType="vm:EventBuilderViewModel">

	<Design.DataContext>
		<vm:EventBuilderViewModel/>
	</Design.DataContext>

	<Grid ColumnDefinitions="*,Auto">
		<Border
			CornerRadius="7"
			BorderThickness="1"
			BorderBrush="{DynamicResource SystemControlBackgroundBaseLowBrush}"
			HorizontalAlignment="Stretch"
			VerticalAlignment="Stretch"/>
		<ScrollViewer
			Margin="5">
			<StackPanel
				Orientation="Vertical"
				Spacing="5"/>
		</ScrollViewer>
		<StackPanel
				Spacing="2"
				Margin="5,0,5,0"
				HorizontalAlignment="Center"
				VerticalAlignment="Top"
				Grid.Column="1">
			<Button
				ToolTip.Tip="Add a new powershell script"
				Classes="IconButton"
				Tag="Plus"
				Foreground="{DynamicResource PlusButton}"
				HorizontalAlignment="Center"
				VerticalAlignment="Top"/>
			<Button
				ToolTip.Tip="Remove the selected powershell script"
				Classes="IconButton"
				Tag="Delete"
				Foreground="{DynamicResource BinButton}"
				HorizontalAlignment="Center"
				VerticalAlignment="Top"/>
		</StackPanel>
	</Grid>

</UserControl>
