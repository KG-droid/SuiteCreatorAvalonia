<UserControl 
	xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:vm="clr-namespace:SuiteCreatorAvalonia.ViewModels"  
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
    xmlns:services="using:SuiteCreatorAvalonia.Services"
    x:Class="SuiteCreatorAvalonia.Views.BrowserExtView"
    services:Help.Title="Extensions"
    services:Help.PageSummary="Install browser extensions as part of the suite. Add an extension event, choose the browser and extension, and control whether it is removed again on uninstall."
    x:DataType="vm:BrowserExtViewModel">

	<Design.DataContext>
		<vm:BrowserExtViewModel/>
	</Design.DataContext>

	<UserControl Content="{Binding IoEventViewModel}"/>
	
</UserControl>
