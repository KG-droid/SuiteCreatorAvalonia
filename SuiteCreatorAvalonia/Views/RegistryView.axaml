<UserControl 
	xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:vm="clr-namespace:SuiteCreatorAvalonia.ViewModels"  
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="450"
    xmlns:services="using:SuiteCreatorAvalonia.Services"
    x:Class="SuiteCreatorAvalonia.Views.RegistryView"
    services:Help.Title="Registry"
    services:Help.PageSummary="Create registry keys and values on the device as part of the suite. Each registry event sets what is written during install and whether it is removed again on uninstall."
    x:DataType="vm:RegistryViewModel">

	<Design.DataContext>
		<vm:RegistryViewModel/>
	</Design.DataContext>

	<UserControl Content="{Binding IoEventViewModel}"/>
	
</UserControl>
