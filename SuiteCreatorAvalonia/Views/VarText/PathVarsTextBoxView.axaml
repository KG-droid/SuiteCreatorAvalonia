<UserControl
	xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:vm="using:SuiteCreatorAvalonia.ViewModels"
	xmlns:AvaloniaEdit="using:AvaloniaEdit"
    mc:Ignorable="d"
	d:DesignWidth="700"
	d:DesignHeight="100"
    x:Class="SuiteCreatorAvalonia.Views.PathVarsTextBoxView"
	x:DataType="vm:PathVarsTextBoxViewModel">

	<Design.DataContext>
		<vm:PathVarsTextBoxViewModel/>
	</Design.DataContext>

	<Border
		x:Name="OuterBorder"
		Height="34"
		CornerRadius="5"
		Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
		<Grid ColumnDefinitions="*,Auto">

			<!--Single-line command editor; variables render as inline pills-->
			<Grid
				Grid.Column="0"
				Margin="7,0,7,0"
				VerticalAlignment="Center">
				<AvaloniaEdit:TextEditor
					x:Name="Editor"
					FontFamily="{DynamicResource ContentControlThemeFontFamily}"
					FontSize="14"
					Background="Transparent"
					WordWrap="False"
					HorizontalScrollBarVisibility="Hidden"
					VerticalScrollBarVisibility="Disabled"
					VerticalAlignment="Center" />
				<TextBlock
					x:Name="Watermark"
					IsVisible="False"
					IsHitTestVisible="False"
					VerticalAlignment="Center"
					TextTrimming="CharacterEllipsis"
					Foreground="{DynamicResource TextControlPlaceholderForeground}" />
			</Grid>

			<!--Add files button-->
			<Button
				Grid.Column="1"
				IsVisible="{Binding IsAddFileButtonVisible}"
				Classes="IconButton"
				Tag="FilePlus"
				Height="34"
				Width="34"
				VerticalAlignment="Center"
				Click="OpenFileTreeModelWindow_Click"
				ToolTip.Tip="Insert a file to the command">
			</Button>

		</Grid>
	</Border>

</UserControl>
