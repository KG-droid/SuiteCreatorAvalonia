<UserControl 
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:vm="clr-namespace:SuiteCreatorAvalonia.ViewModels"  
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mi="using:Material.Icons.Avalonia"
    xmlns:local="clr-namespace:SuiteCreatorAvalonia.Views"
    xmlns:services="using:SuiteCreatorAvalonia.Services"
    mc:Ignorable="d"
    d:DesignWidth="800"
    d:DesignHeight="900"
    x:Class="SuiteCreatorAvalonia.Views.PackageMSIInstallDetailsView"
    x:DataType="vm:PackageMSIInstallDetailsViewModel">

    <Design.DataContext>
		<vm:PackageMSIInstallDetailsViewModel/>
    </Design.DataContext>

    <ScrollViewer>
        <StackPanel
			Spacing="5"
			Margin="20"
			services:Help.Title="MSI package details"
			services:Help.Order="4"
			services:Help.PageSummary="MSI packages are the easy case: Suite Creator handles the install/uninstall commands and detection rule all itself, so you don't need to enter them. You just need to provide the MSI, and any additional settings required like properties and logging, and the Suite will handle the rest."
			services:Help.Text="MSI packages are the easy case: Suite Creator handles the install/uninstall commands and detection rule all itself, so you don't need to enter them. You just need to provide the MSI, and any additional settings required like properties and logging, and the Suite will handle the rest.">
			<!-- Package Name -->
			<Grid 
				ColumnDefinitions="Auto,10,*">
				<TextBlock
					Grid.Column="0"
					Text="Package Name:" />
				<TextBox
					x:Name="PkgName_TextBox"
					Text="{Binding Name}"
					Grid.Column="2"/>
			</Grid>

			<!-- Requirement -->
			<StackPanel
				Margin="0,5,0,5"
				Spacing="10"
				Orientation="Horizontal">
				<TextBlock
					Grid.Row="2"
					Grid.Column="0"
					VerticalAlignment="Center"
					Text="Requirement:"/>
				<ToggleSwitch
					Grid.Row="2"
					Grid.Column="2"
					Grid.ColumnSpan="3"
					Name="Requirement_ToggleSwitch"
					IsChecked="{Binding HasRequirements}"
					VerticalAlignment="Center"
					OffContent=""
					OnContent=""/>
				<TextBlock
					Grid.Row="2"
					Grid.Column="4"
					FontSize="11"
					FontStyle="Italic"
					TextWrapping="Wrap"
					Text="Add a rule/s to determine whether this package should install or not if the detection is not met"/>
			</StackPanel>
			<Expander
				Margin="0,0,0,5"
				IsVisible="{Binding IsChecked, ElementName=Requirement_ToggleSwitch}"
				Background="Transparent"
				Header="Requirement Rules"
				HorizontalAlignment="Stretch">
				<UserControl
					Content="{Binding RequirementRuleBuilder}"/>
			</Expander>

			<UserControl
					Content="{Binding MsiSubDetails}"/>

				<!-- Rollback -->
			<StackPanel
				Margin="0,0,0,10">
				<StackPanel
					Spacing="10"
					Orientation="Horizontal">
					<TextBlock
						Text="Add Rollback"/>
					<ToggleSwitch
						Name="Rollback_ToggleSwitch"
						IsChecked="{Binding AddRollBack}"
						OnContent=""
						OffContent=""/>
				</StackPanel>
				<Expander
					Background="Transparent"
					IsVisible="{Binding IsChecked, ElementName=Rollback_ToggleSwitch}"
					Header="Rollback"
					HorizontalAlignment="Stretch">
					<UserControl
						Content="{Binding Rollback}"/>
				</Expander>
			</StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
