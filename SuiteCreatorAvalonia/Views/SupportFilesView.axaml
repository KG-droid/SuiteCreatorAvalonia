<UserControl 
	xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:vm="clr-namespace:SuiteCreatorAvalonia.ViewModels"  
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
    x:Class="SuiteCreatorAvalonia.Views.SupportFilesView"
    x:DataType="vm:SupportFilesViewModel">

	<Design.DataContext>
		<vm:SupportFilesViewModel/>
	</Design.DataContext>

	<Grid
		RowDefinitions="Auto,*"
		ColumnDefinitions="Auto,*,Auto">
		<TextBlock
			Classes="TabHeader"
			Text="Support Files"
			Grid.ColumnSpan="2"
			Grid.Column="0"/>
	</Grid>
	
</UserControl>
