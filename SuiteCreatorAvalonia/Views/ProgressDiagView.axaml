<UserControl
	xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:vm="using:SuiteCreatorAvalonia.ViewModels"
	mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="200"
    x:Class="SuiteCreatorAvalonia.Views.ProgressDiagView"
	x:DataType="vm:ProgressDiagViewModel">

	<Design.DataContext>
		<vm:ProgressDiagViewModel/>
	</Design.DataContext>

	<StackPanel
		HorizontalAlignment="Center"
		VerticalAlignment="Center"
		Spacing="10">
        <TextBlock
			Text="{Binding Message}"
			FontWeight="Bold"
			FontSize="16"/>
        <ProgressBar
			IsIndeterminate="{Binding !IsZipProgressActive}"
			Minimum="0"
			Maximum="100"
			Value="{Binding ZipPercentValue}"
			Width="200"/>
        <TextBlock
			IsVisible="{Binding IsZipProgressActive}"
			Text="{Binding ZipPercentValue, StringFormat='{}{0:0}%'}"
			HorizontalAlignment="Center"/>
        <Button
			HorizontalAlignment="Right"
			Content="   Cancel  "/>
    </StackPanel>
	
</UserControl>