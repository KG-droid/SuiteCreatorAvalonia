<UserControl
	xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:vm="clr-namespace:SuiteUserPopup.ViewModels"
    xmlns:views="clr-namespace:SuiteUserPopup.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:mi="using:Material.Icons.Avalonia"
    mc:Ignorable="d"
	d:DesignHeight="180"
	d:DesignWidth="330"
    x:Class="SuiteUserPopup.Views.PopupFinalSkipWarningView"
    x:DataType="vm:PopupFinalSkipWarningViewModel">

	<Design.DataContext>
		<vm:PopupFinalSkipWarningViewModel/>
	</Design.DataContext>

	<StackPanel
		Margin="15"
		Spacing="12">

		<StackPanel
			Orientation="Horizontal"
			Spacing="8"
			HorizontalAlignment="Center">
			<mi:MaterialIcon
				Kind="AlertOutline"
				Width="26"
				Height="26"/>
			<TextBlock
				Text="Final Notice"
				FontSize="15"
				FontWeight="Bold"
				VerticalAlignment="Center"/>
		</StackPanel>

		<TextBlock
			Text="This is the last day you can delay this. If you choose Later now, it will be mandatory starting the next day."
			FontSize="13"
			TextWrapping="Wrap"
			TextAlignment="Center"
			HorizontalAlignment="Center"/>

		<Button
			x:CompileBindings="False"
			Command="{Binding $parent[views:PopupMainView].DataContext.ShowPickReminderConfirmedCommand}"
			HorizontalAlignment="Center"
			Width="90"
			Margin="0,5,0,0"
			Background="{DynamicResource ButtonBackground}"
			Foreground="{DynamicResource ButtonForeground}">
			<TextBlock
				Text="OK"
				FontWeight="Bold"
				HorizontalAlignment="Center"/>
		</Button>

	</StackPanel>

</UserControl>
