<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows10.0.22000.0</TargetFramework>
		<Nullable>enable</Nullable>
		<BuiltInComInteropSupport>true</BuiltInComInteropSupport>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
		<Platforms>AnyCPU;x64</Platforms>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<SatelliteResourceLanguages>en-GB</SatelliteResourceLanguages>
	</PropertyGroup>

	<PropertyGroup>
		<PackageIcon>SuiteCreatorLogoImage.png</PackageIcon>
		<ApplicationIcon>SuiteCreatorLogo.ico</ApplicationIcon>
		<Version>1.0.3</Version>
		<AssemblyVersion>1.0.3</AssemblyVersion>
		<FileVersion>1.0.3</FileVersion>
	</PropertyGroup>
	<ItemGroup>
		<Content Include="SuiteCreatorLogo.ico" />
	</ItemGroup>

  <ItemGroup>
	<TrimmerRootDescriptor Include="TrimmerRootDescriptor.xml" />
  </ItemGroup>


	<ItemGroup>
		<PackageReference Include="Avalonia" Version="12.1.0" />
		<PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
		<PackageReference Include="Avalonia.Labs.Gif" Version="12.0.2" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
		<PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.0" />
		<PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Material.Icons.Avalonia" Version="3.0.2" />
		<PackageReference Include="Microsoft.Win32.SystemEvents" Version="10.0.10" />
		<PackageReference Include="System.Drawing.Common" Version="10.0.10" />
	</ItemGroup>


	<ItemGroup>
	  <ProjectReference Include="..\Logger\Logger.csproj" />
	  <ProjectReference Include="..\SuiteCreatorControls\SuiteCreatorControls.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Views\PopupWarningView.axaml.cs">
			<DependentUpon>PopupWarningView.axaml</DependentUpon>
		</Compile>
		<Compile Update="Views\PopupPickReminderView.axaml.cs">
			<DependentUpon>PopupPickReminderView.axaml</DependentUpon>
		</Compile>
		<Compile Update="Views\PopupMainView.axaml.cs">
			<DependentUpon>PopupMainView.axaml</DependentUpon>
		</Compile>
		<Compile Update="Views\PopupWindow.axaml.cs">
			<DependentUpon>PopupWindow.axaml</DependentUpon>
		</Compile>
		<Compile Update="Views\PopupBlockedView.axaml.cs">
			<DependentUpon>PopupBlockedView.axaml</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
	  <None Update="CompanyLogo.png">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	    <CopyToPublishDirectory>Never</CopyToPublishDirectory>
	  </None>
	  <None Update="popconfig.json">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	    <CopyToPublishDirectory>Never</CopyToPublishDirectory>
	  </None>
	  <None Update="SuiteLogo.png">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	    <CopyToPublishDirectory>Never</CopyToPublishDirectory>
	  </None>
	</ItemGroup>
	
</Project>
